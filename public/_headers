/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://cloud.umami.is/script.js https://static.cloudflareinsights.com/beacon.min.js; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.beautica.app https://gateway.umami.is/api/send https://cloudflareinsights.com/cdn-cgi/rum; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# The salon booking wizard's steps (phase 016): an HTML fragment the booking island fetches; not a page.
# Revalidated (ETag) on every use: the fragment's markup is tied to the scripts of the same deploy, so it must never outlive them.
/book-steps/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: public, max-age=0, must-revalidate

/email/*
  Cache-Control: public, max-age=86400

# Token routes: the URL itself is the credential. They load no analytics, so their CSP is the base policy WITHOUT the analytics origins (`! Content-Security-Policy` drops the /* one first). No referrer, never cached, never indexed. `!` drops the /* Referrer-Policy
# first (rules are merged otherwise). /l/* are the shells behind the 200 rewrites in _redirects.
/l/*
  ! Referrer-Policy
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.beautica.app; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

/invite/*
  ! Referrer-Policy
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://api.beautica.app; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'
  Referrer-Policy: no-referrer
