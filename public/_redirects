# Backend email/SMS links -> static shells. Status 200 = rewrite: the address bar keeps the real URL (the page reads the
# token from it). Workers static assets support this (miniflare/asset-worker handleRedirects, status 200 = proxied).
/invite/accept /l/invite 200
/bookings/:id/review /l/review 200
/bookings/:id /l/booking 200
/book/cancel/:token /l/cancel 200
