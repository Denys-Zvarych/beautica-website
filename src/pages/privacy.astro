---
import { getEntry, render } from "astro:content";
import LegalPage from "../components/LegalPage.astro";

const entry = await getEntry("legal", "uk/privacy");
if (!entry) throw new Error("legal: uk/privacy.md is missing");
const { Content, headings } = await render(entry);
---

<LegalPage {...entry.data} path="/privacy" headings={headings}>
  <Content />
</LegalPage>
