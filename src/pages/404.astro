---
import Layout from "../components/Layout.astro";
import NeuCard from "../components/NeuCard.astro";
import CtaButton from "../components/CtaButton.astro";
import LogoTile from "../components/LogoTile.astro";
import { t } from "../i18n/t";
---

<Layout title={t("notFound.metaTitle")} description={t("notFound.metaDescription")} noindex>
  <main id="main" class="wrap">
    <div class="pebbles" aria-hidden="true">
      <span class="pebble p1"></span>
      <span class="pebble p2"></span>
      <span class="pebble p3"></span>
    </div>
    <div class="vt-container stage">
      <NeuCard class="card">
        <div class="digits" aria-hidden="true">
          <span class="digit d1">4</span>
          <span class="zero"><span class="float"><LogoTile size="fill" /></span></span>
          <span class="digit d2">4</span>
        </div>
        <h1 class="vt-heading">{t("notFound.h1")}</h1>
        <p class="vt-prose">{t("notFound.text")}</p>
        <CtaButton href="/" icon="arrow-back">{t("notFound.cta")}</CtaButton>
        <a class="support vt-body" href={`mailto:${t("site.supportEmail")}`}><span class="vt-u">{t("notFound.support")}</span></a>
      </NeuCard>
    </div>
  </main>
</Layout>

<style>
  .wrap {
    position: relative;
    overflow-x: clip;
    display: flex;
    align-items: center;
    padding-block: var(--vt-space-xl);
  }
  .wrap :global(.card) {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--vt-space-md);
    max-width: calc(var(--vt-max-width) / 2.5);
    margin-inline: auto;
    padding-block: var(--vt-space-xl);
    text-align: center;
    position: relative;
    animation: rise 400ms ease-out both;
  }
  .digits {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--vt-space-sm);
    font-family: var(--vt-font-display);
    font-size: calc(var(--vt-fs-display) * 3);
    font-weight: var(--vt-fw-heading);
    line-height: 1;
    color: var(--vt-color-accent-deep);
  }
  /* Fixed boxes (not glyph-sized): swapping the fallback for Comfortaa must not move or resize the row. */
  .digits {
    height: 1em;
  }
  .digit {
    display: block;
    width: 0.7em;
    height: 1em;
    text-align: center;
    animation: drop 800ms cubic-bezier(0.34, 1.3, 0.64, 1) both;
  }
  .d2 {
    animation-delay: 260ms;
  }
  /* The "0" is the app tile: it pops in, then floats and tilts while its shadow breathes. */
  .zero {
    display: block;
    width: calc(var(--vt-fs-display) * 2.4);
    height: calc(var(--vt-fs-display) * 2.4);
    animation: pop 600ms cubic-bezier(0.34, 1.56, 0.64, 1) 130ms both;
  }
  .float {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    isolation: isolate;
    animation: float 6s ease-in-out 900ms infinite;
  }
  .float::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--vt-radius-logo-tile);
    box-shadow: var(--vt-shadow-extruded-card);
    animation: breathe 6s ease-in-out 900ms infinite;
  }

  /* Drifting neumorphic pebbles behind the card: paired light/dark shadows, no blur filters. */
  .pebbles {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .pebble {
    position: absolute;
    border-radius: var(--vt-radius-pill);
    background: var(--vt-color-base);
    box-shadow: var(--vt-shadow-extruded-small);
    animation: drift 18s ease-in-out infinite alternate;
  }
  .p1 {
    top: 8%;
    left: 6%;
    width: calc(var(--vt-size-logo-tile) * 0.6);
    height: calc(var(--vt-size-logo-tile) * 0.6);
  }
  .p2 {
    top: 62%;
    right: 8%;
    width: calc(var(--vt-size-logo-tile) * 0.9);
    height: calc(var(--vt-size-logo-tile) * 0.9);
    background: var(--vt-gradient-accent);
    box-shadow: var(--vt-shadow-extruded-button-accent);
    animation-duration: 23s;
    animation-delay: -6s;
  }
  .p3 {
    bottom: 6%;
    left: 14%;
    width: calc(var(--vt-size-logo-tile) * 0.4);
    height: calc(var(--vt-size-logo-tile) * 0.4);
    animation-duration: 15s;
    animation-delay: -3s;
  }
  .stage {
    position: relative;
  }
  .support {
    display: flex;
    align-self: stretch;
    align-items: center;
    justify-content: center;
    min-height: var(--vt-touch-min);
    padding-inline: var(--vt-space-md);
    color: var(--vt-color-accent-deep);
  }
  /* transform/opacity only. The global reduced-motion rule removes every animation: everything rests visible. */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(var(--vt-space-md));
    }
  }
  @keyframes drop {
    0% {
      opacity: 0;
      transform: translateY(calc(var(--vt-space-xxl) * -2));
    }
    55% {
      opacity: 1;
      transform: translateY(0);
    }
    75% {
      transform: translateY(calc(var(--vt-space-sm) * -1));
    }
    100% {
      transform: translateY(0);
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(0.5);
    }
  }
  @keyframes float {
    0%,
    100% {
      transform: translateY(0) rotate(-3deg);
    }
    50% {
      transform: translateY(calc(var(--vt-space-sm) * -1)) rotate(3deg);
    }
  }
  @keyframes breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }
  @keyframes drift {
    from {
      transform: translate3d(0, 0, 0);
    }
    to {
      transform: translate3d(var(--vt-space-xl), calc(var(--vt-space-lg) * -1), 0);
    }
  }
</style>
