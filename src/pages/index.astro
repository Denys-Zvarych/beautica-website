---
import LogoTile from "../components/LogoTile.astro";
import Layout from "../components/Layout.astro";
import Chip from "../components/Chip.astro";
import { t } from "../i18n/t";
---

<Layout title={t("index.metaTitle")} description={t("index.metaDescription")} hideHeader>
  <main id="main" class="hero">
    <div class="vt-container stack">
      <LogoTile priority />
      <h1 class="vt-display">{t("index.h1")}</h1>
      <p class="vt-prose">{t("index.lead")}</p>
      <ul class="chips">
        <li><Chip icon="google-play">{t("index.soonGooglePlay")}</Chip></li>
        <li><Chip icon="app-store">{t("index.soonAppStore")}</Chip></li>
      </ul>
    </div>
  </main>
</Layout>

<style>
  .hero {
    display: flex;
    align-items: center;
    padding-block: var(--vt-space-xxl);
  }
  .stack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--vt-space-md);
    text-align: center;
  }
  /* One chip per line on phones. Side by side they fit only in a narrow band of widths (~385-420 px) and the answer flips
     when the webfont swaps in, which reflowed the hero (CLS ~0.06). A fixed stack cannot change row count. */
  .chips {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--vt-space-md);
    margin: var(--vt-space-sm) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 600px) {
    .chips {
      flex-direction: row;
    }
  }
</style>
