---
// A service category accordion (the app's catalogue category card + its service tiles). <details>: opens and closes without script.
// `selectable` adds the "N selected" badge the booking step updates. The count badge is the number of services in the group.
import Icon from "../Icon.astro";
import { categoryIconFor, remoteIconFor, type CategoryIcons } from "../../lib/categoryIcon";
interface Props {
  name: string;
  categoryKey?: string | null;
  /** Server icon URLs (W050); absent = the bundled icon only. */
  icons?: CategoryIcons;
  count: number;
  open?: boolean;
  selectable?: boolean;
}
const { name, categoryKey = null, icons, count, open = true, selectable = false } = Astro.props;
const bundled = categoryIconFor(name, categoryKey);
const remote = remoteIconFor(name, categoryKey, icons); // the noscript copy stays bundled: a failed remote mask cannot fall back without script
---

<details class="cat-group" open={open} data-cat-group>
  <summary class="cat">
    <span class="ico"><span class="ai" aria-hidden="true" data-src={remote ? undefined : bundled} data-remote={remote ?? undefined} data-fallback={remote ? bundled : undefined}></span><noscript><span class="ai" aria-hidden="true" style={`--src: url(${bundled})`}></span></noscript></span>
    <span class="lbl t-sub13 ellipsis">{name}</span>
    {selectable && <span class="badge sel" data-sel-badge hidden><Icon name="done" /><span class="t-fb w800" data-sel-n>0</span></span>}
    <span class="badge"><span class="t-fb w800">{count}</span></span>
    <span class="chev" aria-hidden="true"><Icon name="keyboard-arrow-down" /></span>
  </summary>
  <div class="acc-body"><slot /></div>
</details>
