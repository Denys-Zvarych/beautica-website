---
// A service category accordion (the app's catalogue category card + its service tiles). <details>: opens and closes without script.
// `selectable` adds the "N selected" badge the booking step updates. The count badge is the number of services in the group.
import Icon from "../Icon.astro";
import { categoryIconFor } from "../../lib/categoryIcon";
interface Props {
  name: string;
  categoryKey?: string | null;
  count: number;
  open?: boolean;
  selectable?: boolean;
}
const { name, categoryKey = null, count, open = true, selectable = false } = Astro.props;
---

<details class="cat-group" open={open} data-cat-group>
  <summary class="cat">
    <span class="ico"><span class="ai" aria-hidden="true" data-src={categoryIconFor(name, categoryKey)}></span><noscript><span class="ai" aria-hidden="true" style={`--src: url(${categoryIconFor(name, categoryKey)})`}></span></noscript></span>
    <span class="lbl t-sub13 ellipsis">{name}</span>
    {selectable && <span class="badge sel" data-sel-badge hidden><Icon name="done" /><span class="t-fb w800" data-sel-n>0</span></span>}
    <span class="badge"><span class="t-fb w800">{count}</span></span>
    <span class="chev" aria-hidden="true"><Icon name="keyboard-arrow-down" /></span>
  </summary>
  <div class="acc-body"><slot /></div>
</details>
