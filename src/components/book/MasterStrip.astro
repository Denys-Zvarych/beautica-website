---
// Mirrors MasterStrip (showRole + showRating): avatar disc, «Запис до майстра», name, the title (else the role label) and the ★ rating —
// «★ —» for a master with no reviews, the muted «(n)» only when n > 0. Repeated on every booking step.
import Icon from "../Icon.astro";
import { t } from "../../i18n/t";
import { formatRating } from "../../lib/booking/format";
interface Props {
  name: string;
  subtitle: string | null;
  avatarUrl: string | null;
  rating: number | null;
  reviewCount: number;
  /** Role label fallback (masterRoleLabel): a salon master vs an independent one. */
  salonMaster?: boolean;
  /** Caption above the name (default «Запис до майстра»); the guest review page says «Ваш візит до …». */
  label?: string;
  /** false = no rating cluster at all (a caller that has no rating data); default true, unchanged. */
  showRating?: boolean;
}
const { name, subtitle, avatarUrl, rating, reviewCount, salonMaster = false, label, showRating = true } = Astro.props;
const role = subtitle?.trim() || t(salonMaster ? "book.strip.roleSalonMaster" : "book.strip.roleIndependent");
const shown = reviewCount > 0 ? rating : null;
---

<div class="strip">
  <span class="disc" aria-hidden="true">{avatarUrl ? <img src={avatarUrl} alt="" width="52" height="52" loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : <Icon name="person" />}</span>
  <div class="txt">
    <p class="t-fb sec">{label ?? t("book.strip.label")}</p>
    <p class="t-sub13 ellipsis">{name}</p>
    <div class="sub">
      <span class="t-fb muted ellipsis">{role}</span>
      {showRating && <span class="rate">
        <Icon name="star" />
        <span class="t-strong11">{formatRating(shown)}</span>
        {reviewCount > 0 && <span class="t-fb muted">({reviewCount})</span>}
      </span>}
    </div>
  </div>
</div>
