---
// Booking success screen (phase 022; reused by the cancel page, phase 024): «Куди ви хочете отримувати нагадування про запис?».
// Hidden in the HTML; src/scripts/booking/reminder-channel.ts shows exactly one state (linked status or the SMS / Telegram choice)
// and only when the backend says Telegram is available. All copy is server-rendered here, so the script only toggles `hidden`.
import NeuCard from "../NeuCard.astro";
import Icon from "../Icon.astro";
import { t } from "../../i18n/t";
import "../../styles/remind.css";
---

<div class="remind reveal" id="done-reminders" hidden>
  <NeuCard bordered pad="sm">
    <div data-r-linked hidden>
      <p class="okline t-fb"><Icon name="check-circle" />{t("book.done.reminders.linked")}</p>
      <div class="gap"></div>
      <button type="button" class="cta2" data-r-unlink><span class="vt-cta">{t("book.done.reminders.backToSms")}</span></button>
    </div>
    <div data-r-choice hidden>
      <p class="t-sub13" id="reminders-h">{t("book.done.reminders.heading")}</p>
      <div class="gap"></div>
      <div role="radiogroup" aria-labelledby="reminders-h" class="opts">
        <label class="opt">
          <input type="radio" name="reminder-channel" value="sms" checked />
          <span class="dot" aria-hidden="true"></span>
          <span class="t-body11">{t("book.done.reminders.sms")}</span>
        </label>
        <label class="opt">
          <input type="radio" name="reminder-channel" value="telegram" aria-describedby="reminders-help" />
          <span class="dot" aria-hidden="true"></span>
          <span class="t-body11 name"><Icon name="telegram" />{t("book.done.reminders.telegram")}</span>
        </label>
      </div>
      <p class="t-fb muted help" id="reminders-help">{t("book.done.reminders.helper")}</p>
      <div class="gap" data-r-connect-gap hidden></div>
      <button type="button" class="cta2" data-r-connect hidden><Icon name="telegram" /><span class="vt-cta">{t("book.done.reminders.connect")}</span></button>
    </div>
    <p class="t-body11" data-r-unavailable hidden>{t("book.done.reminders.unavailable")}</p>
    <div class="errcard mt-md" role="alert" data-r-error hidden>
      <Icon name="error-outline" />
      <span class="t-fb err">
        <span data-r-err="rate" hidden>{t("book.done.reminders.tooMany")}</span>
        <span data-r-err="fail" hidden>{t("book.done.reminders.failed")}</span>
        <span data-r-err="unlink" hidden>{t("book.done.reminders.unlinkFailed")}</span>
      </span>
    </div>
  </NeuCard>
</div>

<style>
  .gap {
    height: var(--vt-space-sm);
  }
  .opts {
    display: flex;
    flex-direction: column;
    gap: var(--vt-space-sm);
  }
  .opt {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--vt-space-md);
    min-height: var(--vt-touch-min);
    padding-inline: var(--vt-space-sm);
    cursor: pointer;
  }
  .opt input {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .opt input:disabled {
    cursor: default;
  }
  .dot {
    flex: none;
    width: var(--vt-space-lg);
    height: var(--vt-space-lg);
    border-radius: var(--vt-radius-pill);
    background: var(--vt-color-base);
    box-shadow: var(--vt-app-shadow-inset);
    display: grid;
    place-items: center;
  }
  /* Selected: the accent disc inside the well. */
  .dot::after {
    content: "";
    width: var(--vt-space-sm);
    height: var(--vt-space-sm);
    border-radius: var(--vt-radius-pill);
    background: var(--vt-gradient-accent);
    opacity: 0;
    transform: scale(0.5);
    transition: opacity var(--vt-dur-fast) var(--vt-ease), transform var(--vt-dur-fast) var(--vt-ease);
  }
  input:checked ~ .dot::after {
    opacity: 1;
    transform: none;
  }
  input:focus-visible ~ .dot {
    outline: medium solid var(--vt-color-accent-deep);
    outline-offset: var(--vt-space-xs);
  }
  input:disabled ~ * {
    opacity: 0.6;
  }
  .name {
    display: inline-flex;
    align-items: center;
    --icon-size: var(--vt-app-icon-18);
    --icon-gap: var(--vt-space-xs);
  }
  .help {
    margin: var(--vt-space-xs) 0 0;
    padding-inline: var(--vt-space-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    .dot::after,
    .reveal,
    .remind :global(.cta2),
    .remind :global(.cta2::before) {
      transition: none;
      animation: none;
    }
  }
</style>
