---
// Salon link page body (mirrors PublicSalonProfileScreen): cover, hero card, tabs, bookable masters, services, reviews. The sticky CTA
// «Записатись на послугу» opens the salon booking wizard (phase 016, the app's services -> masters -> time -> confirm). A master card
// opens that master's own link page when the master has one; a salon master without a personal link gets a plain, non-link card.
// A tap on a service in the «Послуги» tab filters the «Майстри» tab (phase 017, like the app).
import NeuCard from "../NeuCard.astro";
import CategoryGroup from "./CategoryGroup.astro";
import ReviewsSection from "./ReviewsSection.astro";
import ServiceTile from "./ServiceTile.astro";
import CtaButton from "../CtaButton.astro";
import Icon from "../Icon.astro";
import { t } from "../../i18n/t";
import { formatDuration, formatRating, pluralReviews, streetLine, type ReviewSort } from "../../lib/booking/format";
import type { ReviewItem, SalonInfo } from "../../lib/booking/types";
import { serviceNameHints } from "../../lib/booking/serviceHint.ts";

interface Props {
  info: SalonInfo;
  apiOrigin: string;
  sort: ReviewSort;
  reviews: ReviewItem[];
}
const { info, apiOrigin, sort, reviews } = Astro.props;
const FIRST = 6;
const first = info.masters.slice(0, FIRST);
const rest = info.masters.slice(FIRST);
const avatarClass = (name: string) => `av-${(Array.from(name).reduce((a, c) => a + c.codePointAt(0)!, 0) % 6) + 1}`;
// Address lines exactly like the app's hero card (_localityLine/_streetLine): a street promotes the street line and drops the
// locality line (a stale city must not ride along); without a street the city stands alone.
const vis = (v: string | null) => v?.trim() || null;
const streetLn = streetLine(vis(info.street), vis(info.buildingNo));
const localityLn = streetLn ? null : vis(info.city);
const note = vis(info.locationNote);
// The logo initial skips the word «Салон» («Салон «Лаванда»» -> Л), like the app's monogram of the brand name.
const monogram = Array.from(info.name.replace(/^салон\s+/iu, "").replace(/^[^\p{L}\p{N}]+/u, ""))[0]?.toUpperCase() ?? "";
const firstName = (n: string) => n.trim().split(/\s+/)[0] ?? n;
const hints = serviceNameHints(info.serviceCategories.flatMap((g) => g.services));
const filterable = info.serviceCoverage.length > 0 && info.masters.length > 0;
const canBook = info.masters.length > 0 && info.serviceCategories.length > 0 && info.serviceCoverage.some((c) => c.masters.length > 0);
---

<section class="screen" data-screen="profile">
<div class="body">
  <div class="cover">
    {info.coverImageUrl ? <img src={info.coverImageUrl} alt="" width="420" height="232" fetchpriority="high" referrerpolicy="no-referrer" /> : <span class="cam"><Icon name="photo-camera-back" /></span>}
  </div>
  <div class="hero-wrap">
    <NeuCard emphasis pad="md-plus">
      <div class="hero-row">
        <span class="slogo" role="img" aria-label={t("book.salon.logoAlt")}>{info.avatarUrl ? <img src={info.avatarUrl} alt="" width="68" height="68" decoding="async" referrerpolicy="no-referrer" /> : monogram}</span>
        <div class="min0 grow">
          <h1 class="t-name-17">{info.name}</h1>
          <div class="g-xs"></div>
          <div class="ratingline">
            <Icon name="star" />
            <span class="t-strong11">{formatRating(info.avgRating)}</span>
            <span class="t-fb muted ellipsis">· {pluralReviews(info.reviewCount)}</span>
          </div>
        </div>
      </div>
      {
        (localityLn || streetLn) && (
          <>
            <div class="g-xs"></div>
            <div class="addr-line">
              <Icon name="location-on" />
              <span class="addr-lines t-fb sec">
                {localityLn && <span class="addr-l">{localityLn}</span>}
                {streetLn && <span class="addr-l">{streetLn}</span>}
              </span>
            </div>
          </>
        )
      }
      {note && <p class="t-fb muted hero-note">{note}</p>}
    </NeuCard>
  </div>
  <div class="g-lg"></div>
  <div class="pad-h">
    <nav class="tabs" data-tabs aria-label={t("book.salon.tabsLabel")}>
      {
        ["about", "masters", "services", "reviews"].map((k, i) => (
          <a class="tab" href={`#panel-${i}`} data-tab={i} aria-current={i === 0 ? "true" : undefined}>
            <span class="t-sub11 ellipsis">{t(`book.salon.tabs.${k}`)}</span>
            <span class="bar"></span>
          </a>
        ))
      }
    </nav>
  </div>
  <div class="g-lg"></div>
  <div class="pad-h" data-panels>
    <div class="tabpanel" id="panel-0" data-panel="0">
      <h2 class="sr-only">{t("book.salon.aboutLabel")}</h2>
      {info.description ? <p class="t-strong bio-text">{info.description}</p> : <p class="t-fb muted muted-note">{t("book.salon.noAbout")}</p>}
      {
        info.portfolio.length > 0 && (
          <div class="sect">
            <h3 class="t-section sect-label">{t("book.salon.portfolio")}</h3>
            <section class="rail" tabindex="0" aria-label={t("book.salon.portfolio")}>
              {info.portfolio.map((src, i) => (
                <span class="ptile"><img src={src} alt={t("book.salon.photoAlt", { n: i + 1 })} width="72" height="72" loading="lazy" decoding="async" referrerpolicy="no-referrer" /></span>
              ))}
            </section>
          </div>
        )
      }
    </div>

    <div class="tabpanel" id="panel-1" data-panel="1">
      <h2 class="sr-only">{t("book.salon.mastersLabel")}</h2>
      {
        filterable && (
          <div class="fchip-row" data-filter-chip data-template={t("book.salon.filterChip", { name: "{name}" })} aria-live="polite" hidden>
            <span class="fchip">
              <Icon name="spa" />
              <span class="t-strong11 ellipsis" data-filter-label></span>
              <button type="button" class="fclear" data-filter-clear aria-label={t("book.salon.filterClear")}><span class="x"><Icon name="close-rounded" /></span></button>
            </span>
          </div>
        )
      }
      {filterable && <p class="t-fb muted muted-note" data-filter-empty hidden>{t("book.salon.filterEmpty")}</p>}
      <div class="mgrid" data-mgrid>
        {
          first.map((m) => {
            const Tag = m.masterSlug ? "a" : "div";
            return (
              <Tag class={m.masterSlug ? "mcard" : "mcard plain"} href={m.masterSlug ? `/book/${m.masterSlug}` : undefined} role={m.masterSlug ? undefined : "group"} data-master-id={m.masterId} aria-label={[m.name, m.professionalTitle, m.avgRating !== null ? t("book.salon.ratingOf", { rating: formatRating(m.avgRating) }) : null].filter(Boolean).join(", ")}>
                <span class={`mav ${avatarClass(m.name)}`}>{m.avatarUrl ? <img src={m.avatarUrl} alt="" width="73" height="73" loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : <Icon name="person" />}</span>
                <span class="t-sub11 ellipsis">{firstName(m.name)}</span>
                {m.professionalTitle && <span class="role t-fb muted">{m.professionalTitle}</span>}
                {m.avgRating !== null && <span class="mrate"><Icon name="star" /><span class="t-strong11">{formatRating(m.avgRating)}</span></span>}
              </Tag>
            );
          })
        }
      </div>
      {
        rest.length > 0 && (
          <>
            <div class="g-sm"></div>
            <button type="button" class="showall js-only" id="showall" hidden><span class="t-link">{t("book.salon.showAll")}</span><Icon name="keyboard-arrow-down" /></button>
            <div class="mgrid more" id="mrest" data-collapsible data-mgrid>
              {rest.map((m) => {
                const Tag = m.masterSlug ? "a" : "div";
                return (
                  <Tag class={m.masterSlug ? "mcard" : "mcard plain"} href={m.masterSlug ? `/book/${m.masterSlug}` : undefined} role={m.masterSlug ? undefined : "group"} data-master-id={m.masterId} aria-label={[m.name, m.professionalTitle, m.avgRating !== null ? t("book.salon.ratingOf", { rating: formatRating(m.avgRating) }) : null].filter(Boolean).join(", ")}>
                    <span class={`mav ${avatarClass(m.name)}`}>{m.avatarUrl ? <img src={m.avatarUrl} alt="" width="73" height="73" loading="lazy" decoding="async" referrerpolicy="no-referrer" /> : <Icon name="person" />}</span>
                    <span class="t-sub11 ellipsis">{firstName(m.name)}</span>
                    {m.professionalTitle && <span class="role t-fb muted">{m.professionalTitle}</span>}
                    {m.avgRating !== null && <span class="mrate"><Icon name="star" /><span class="t-strong11">{formatRating(m.avgRating)}</span></span>}
                  </Tag>
                );
              })}
            </div>
          </>
        )
      }
    </div>

    <div class="tabpanel" id="panel-2" data-panel="2" data-svc-filter={filterable ? "" : undefined}>
      <h2 class="sr-only">{t("book.salon.servicesLabel")}</h2>
      {filterable && <p class="t-fb muted muted-note" data-filter-hint>{t("book.salon.filterHint")}</p>}
      {info.serviceCategories.length === 0 && <p class="t-fb muted muted-note">{t("book.salon.noServices")}</p>}
      {
        info.serviceCategories.map((g, i) => (
          <CategoryGroup name={g.displayName} categoryKey={g.category} count={g.count} open={i === 0}>
            {g.services.map((sv) => <ServiceTile name={sv.name} price={sv.priceLabel} duration={formatDuration(sv.durationMinutes)} hint={hints.get(sv.id)} filterId={filterable ? sv.id : undefined} />)}
          </CategoryGroup>
        ))
      }
    </div>

    <div class="tabpanel" id="panel-3" data-panel="3">
      <h2 class="sr-only">{t("book.salon.reviewsLabel")}</h2>
      <ReviewsSection kind="salon" slug={info.slug} apiOrigin={apiOrigin} avg={info.avgRating} count={info.reviewCount} buckets={info.ratingDistribution} reviews={reviews} sort={sort} anchor="panel-3" />
    </div>
  </div>
  <div class="g-xxl"></div>
</div>
<div class="shelf salon">
  {
    canBook ? (
      <>
        <div class="js-only" hidden data-book-cta data-error={t("book.notice.unavailable.text")}>
          <CtaButton type="button" id="book-cta" icon="event-available">{t("book.salon.cta")}</CtaButton>
        </div>
        <div class="nojs" data-nojs><CtaButton href="#panel-1" icon="event-available">{t("book.salon.cta")}</CtaButton></div>
      </>
    ) : (
      <CtaButton href="#panel-1" icon="event-available">{t("book.salon.cta")}</CtaButton>
    )
  }
</div>
</section>
