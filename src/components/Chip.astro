---
// Mirrors ServiceChip: 40 px tall, fully rounded, selected = gradient fill.
// Non-interactive label by default; becomes a link only when `href` is passed (then >= 48 px tall).
// Optional `icon` prop (a name from Icon.astro; decorative, the text stays the accessible name). No prop = unchanged.
import Icon, { type IconName } from "./Icon.astro";
interface Props {
  icon?: IconName;
  selected?: boolean;
  href?: string;
  class?: string;
}
const { icon, selected = false, href, class: className } = Astro.props;
const Tag = href ? "a" : "span";
---

<Tag class:list={["chip vt-pill", { selected, link: !!href }, className]} href={href}>
  {icon && <Icon name={icon} />}
  <slot />
</Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: calc(var(--vt-space-xl) + var(--vt-space-sm));
    padding-inline: var(--vt-space-md);
    border-radius: var(--vt-radius-pill);
    background: var(--vt-color-base);
    box-shadow: var(--vt-shadow-extruded-small);
    text-decoration: none;
  }
  .chip.link {
    min-height: var(--vt-touch-min);
    transition:
      transform var(--vt-dur-fast) var(--vt-ease),
      box-shadow var(--vt-dur-fast) var(--vt-ease);
  }
  /* Interactive chips (links) rise softly and swap to the larger extruded shadow; plain label chips stay still. */
  .chip.link:focus-visible {
    transform: translateY(calc(var(--vt-lift) * -1));
    box-shadow: var(--vt-shadow-extruded-button);
  }
  @media (hover: hover) {
    .chip.link:hover {
      transform: translateY(calc(var(--vt-lift) * -1));
      box-shadow: var(--vt-shadow-extruded-button);
    }
  }
  .chip.link:active {
    transform: scale(0.98);
  }
  .chip.selected {
    background: var(--vt-gradient-accent);
    color: var(--vt-color-cream);
  }
</style>
