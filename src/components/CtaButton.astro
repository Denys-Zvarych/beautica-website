---
// Mirrors NeumorphicButton: 49 px, radius 16, latte->deep gradient, extrudedButtonAccent,
// cream Comfortaa 13/700, pressed = scale(.97) + shadow off (shadow lives on ::before, opacity only).
// Optional `icon` prop (a name from Icon.astro): decorative leading glyph. No prop = unchanged.
// Optional `name` + `value` (button only): which of several submit buttons of one form was pressed (no-JS admin forms).
// Optional `type` ("submit" | "button") renders a <button> with the same classes instead of a link; `id` for scripts.
// Optional `spinner` (button only): reserves a pure-CSS ring + a `.lbl` label span; the ring shows while a script sets aria-busy="true".
import Icon, { type IconName } from "./Icon.astro";
interface Props {
  href?: string;
  type?: "submit" | "button";
  id?: string;
  icon?: IconName;
  class?: string;
  spinner?: boolean;
  name?: string;
  value?: string;
}
const { href, type, id, icon, class: className, spinner = false, name, value } = Astro.props;
---

{
  type ? (
    <button class:list={["cta vt-cta", className]} type={type} id={id} name={name} value={value}>
      {icon && <Icon name={icon} />}
      {spinner && <span class="spin" aria-hidden="true" />}
      {spinner ? <span class="lbl"><slot /></span> : <slot />}
    </button>
  ) : (
    <a class:list={["cta vt-cta", className]} href={href} id={id}>
      {icon && <Icon name={icon} />}
      <slot />
    </a>
  )
}

<style>
  .cta {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: var(--vt-size-cta);
    padding-inline: var(--vt-space-lg);
    border-radius: var(--vt-radius-button);
    background: var(--vt-gradient-accent);
    text-decoration: none;
    border: 0;
    cursor: pointer;
    transition: transform var(--vt-dur-fast) var(--vt-ease);
  }
  .cta::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    box-shadow: var(--vt-shadow-extruded-button-accent);
    transition:
      opacity var(--vt-dur-fast) var(--vt-ease),
      transform var(--vt-dur-fast) var(--vt-ease);
  }
  /* Pressed layer: an inset shadow built from tokens, faded in on :active. */
  .cta::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset var(--vt-space-xs) var(--vt-space-xs) var(--vt-space-sm) var(--vt-color-accent-deep);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--vt-dur-fast) var(--vt-ease);
  }
  /* Lift: the button rises while its shadow stays put, so the shadow reads deeper. Same look for keyboard focus. */
  .cta:focus-visible {
    transform: translateY(calc(var(--vt-lift) * -1));
  }
  .cta:focus-visible::before {
    transform: translateY(var(--vt-lift));
  }
  @media (hover: hover) {
    .cta:hover {
      transform: translateY(calc(var(--vt-lift) * -1));
    }
    .cta:hover::before {
      transform: translateY(var(--vt-lift));
    }
  }
  .cta:disabled {
    cursor: progress;
    opacity: 0.7;
  }
  /* Sending state (spinner prop): a cream ring with one solid arc; rotation is transform-only. */
  .spin {
    display: none;
    flex: none;
    box-sizing: border-box;
    width: calc(var(--vt-space-md) + var(--vt-space-xs));
    height: calc(var(--vt-space-md) + var(--vt-space-xs));
    margin-inline-end: var(--vt-space-sm);
    border: calc(var(--vt-space-xs) / 2) solid color-mix(in srgb, var(--vt-color-cream) 35%, transparent);
    border-top-color: var(--vt-color-cream);
    border-radius: var(--vt-radius-pill);
    animation: cta-spin 0.9s linear infinite;
  }
  .cta[aria-busy="true"] .spin {
    display: inline-block;
  }
  @keyframes cta-spin {
    to {
      transform: rotate(360deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .spin {
      animation: none;
    }
  }
  .cta:active {
    transform: scale(0.98);
  }
  .cta:active::before {
    opacity: 0;
  }
  .cta:active::after {
    opacity: 1;
  }
</style>
