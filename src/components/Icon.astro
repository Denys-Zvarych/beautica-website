---

<span class:list={["icon", { nudge, chev, lg: size === "lg", draw }]} aria-hidden="true">
  {
    stroked ? (
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" xmlns="http://www.w3.org/2000/svg" focusable="false">
        <path d="M5 12.5l4.5 4.5L19 7.5" pathLength="1"></path>
      </svg>
    ) : (
      <svg viewBox="0 0 24 24" width="1.25em" height="1.25em" fill="currentColor" xmlns="http://www.w3.org/2000/svg" focusable="false"><path d={paths[name]}></path></svg>
    )
  }
</span>

<style>
  .icon {
    display: inline-flex;
    flex: none;
    width: calc(var(--vt-space-md) + var(--vt-space-xs));
    height: calc(var(--vt-space-md) + var(--vt-space-xs));
    margin-inline-end: var(--vt-space-sm);
  }
  .icon {
    transition: transform var(--vt-dur-fast) var(--vt-ease);
  }
  .icon svg {
    width: 100%;
    height: 100%;
  }
  .icon svg:not([fill="none"]) {
    fill: currentColor;
  }
  .lg {
    width: var(--vt-space-xl);
    height: var(--vt-space-xl);
  }
  /* Draw-in: the resting state is the finished check, so reduced motion (animation off) shows it instantly. */
  .draw path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
    animation: icon-draw var(--vt-dur-base) var(--vt-ease) var(--vt-dur-base) backwards;
  }
  @keyframes icon-draw {
    from {
      stroke-dashoffset: 1;
    }
  }
  /* Disclosure chevron: rotation is a transform on the icon only; reduced motion drops the transition (base.css), the open
     state still shows the turned glyph. */
  :global(details[open]) > :global(summary) .chev {
    transform: rotate(180deg);
  }
  :global(a:focus-visible) .nudge,
  :global(button:focus-visible) .nudge {
    transform: translateX(calc(var(--vt-space-xs) * -1));
  }
  @media (hover: hover) {
    :global(a:hover) .nudge,
    :global(button:hover) .nudge {
      transform: translateX(calc(var(--vt-space-xs) * -1));
    }
  }
</style>
