---
// Shared layout for /privacy and /terms: H1, version + effective date, table of contents, prose body.
// Reuses Layout (Seo/Header/Footer) and NeuCard; the Markdown body arrives through the default slot.
import Layout from "./Layout.astro";
import "../styles/fonts-legal.css"; // after Layout: its @font-face must come after the full faces of fonts.css (the later rule wins)
import NeuCard from "./NeuCard.astro";
import Icon from "./Icon.astro";
import CtaButton from "./CtaButton.astro";
import type { IconName } from "./Icon.astro";
import { t } from "../i18n/t";
import { breadcrumbList } from "../lib/jsonld";

interface Props {
  title: string;
  metaTitle: string;
  description: string;
  version: string;
  updated: Date;
  /** Public path, e.g. "/privacy" (canonical + breadcrumb). */
  path: string;
  /** Markdown headings from render(); only depth 2 enter the table of contents. */
  headings: { depth: number; slug: string; text: string }[];
  /** Optional primary action under the title (e.g. a prefilled mailto). */
  /** Label for the date line; defaults to the policy wording «Дата набрання чинності». */
  dateLabel?: string;
  cta?: { href: string; label: string; icon?: IconName; id?: string };
}

const { title, metaTitle, description, version, updated, path, headings, cta, dateLabel = t("legal.effective") } = Astro.props;
const toc = headings.filter((h) => h.depth === 2);
const site = Astro.site as URL;
const effective = updated.toLocaleDateString("uk-UA", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" });
const jsonLd = breadcrumbList([
  { name: t("site.name"), url: new URL("/", site).href },
  { name: title, url: new URL(path, site).href },
]);
---

<Layout title={metaTitle} description={description} canonicalPath={path} jsonLd={jsonLd} basicLatin>
  <main id="main" class="legal">
    <div class="vt-container column">
      <header class="intro">
        <h1 class="vt-display">{title}</h1>
        <p class="vt-label meta">
          <span>{t("legal.version", { version })}</span>
          <span>{dateLabel}: <time datetime={updated.toISOString().slice(0, 10)}>{effective}</time></span>
        </p>
        {cta && <CtaButton class="intro-cta" href={cta.href} icon={cta.icon} id={cta.id}>{cta.label}</CtaButton>}
      </header>

      <NeuCard as="section" class="toc-card">
        <details class="toc-details">
          <summary class="vt-card-title"><span>{t("legal.toc")}</span><Icon name="expand-more" /></summary>
          <nav aria-label={t("legal.toc")}>
            <ol class="toc">
              {
                toc.map((h) => (
                  <li>
                    <a class="vt-prose" href={`#${h.slug}`}>
                      {h.text}
                    </a>
                  </li>
                ))
              }
            </ol>
          </nav>
        </details>
      </NeuCard>

      <NeuCard as="article" class="body-card">
        <div class="prose vt-prose"><slot /></div>
      </NeuCard>

      <p class="vt-label back"><a href="/"><Icon name="arrow-back" /><span class="vt-u">{t("legal.home")}</span></a></p>
    </div>
  </main>
</Layout>

<style>
  .legal {
    padding-block: var(--vt-space-lg) var(--vt-space-xxl);
  }
  .column {
    display: flex;
    flex-direction: column;
    gap: var(--vt-space-lg);
  }
  .intro {
    display: flex;
    flex-direction: column;
    gap: var(--vt-space-sm);
  }
  /* Version and date on their own lines: one line in the fallback face must not become two in Nunito (CLS). */
  .meta {
    display: flex;
    flex-direction: column;
  }
  .intro :global(.intro-cta) {
    align-self: flex-start;
  }
  /* Phones: tighter card padding and section rhythm (the 24/32 px steps return from 400 px). */
  .legal :global(.neu-card.toc-card),
  .legal :global(.neu-card.body-card) {
    padding: var(--vt-space-md);
  }

  /* Table of contents: a <details>, closed on phones, always shown from tablet up. */
  .toc-details summary {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--vt-touch-min);
    margin-inline: calc(var(--vt-space-sm) * -1);
    padding-inline: var(--vt-space-sm);
    list-style: none;
    cursor: pointer;
  }
  .toc-details summary::-webkit-details-marker {
    display: none;
  }
  .toc-details summary :global(.icon) {
    margin: 0;
  }
  .toc-details summary::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--vt-radius-button);
    box-shadow: var(--vt-shadow-bordered-card);
    opacity: 0;
    transition: opacity var(--vt-dur-fast) var(--vt-ease);
  }
  .toc-details summary:focus-visible::before {
    opacity: 1;
  }
  @media (hover: hover) {
    .toc-details summary:hover::before {
      opacity: 1;
    }
  }
  .toc {
    margin: var(--vt-space-sm) 0 0;
    padding: 0;
    list-style: none;
  }
  .toc a {
    position: relative;
    isolation: isolate;
    margin-inline: calc(var(--vt-space-sm) * -1);
    padding-inline: var(--vt-space-sm);
    display: flex;
    align-items: center;
    min-height: var(--vt-touch-min);
    padding-block: var(--vt-space-xs);
  }
  /* Soft row highlight: a bordered-card glow fades in behind the row (opacity only). */
  .toc a::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: var(--vt-radius-button);
    box-shadow: var(--vt-shadow-bordered-card);
    opacity: 0;
    transition: opacity var(--vt-dur-fast) var(--vt-ease);
  }
  .toc a:focus-visible::before {
    opacity: 1;
  }
  @media (hover: hover) {
    .toc a:hover::before {
      opacity: 1;
    }
  }
  /* No entrance animation on the cards: the H1 and the TOC text are LCP candidates and must paint immediately. */
  @media (min-width: 400px) {
    .legal :global(.neu-card.toc-card),
    .legal :global(.neu-card.body-card) {
      padding: var(--vt-space-lg);
    }
  }
  @media (min-width: 600px) {
    /* The list is always visible: CSS forces the closed <details> content open (no layout shift, no script needed), the
       script below mirrors it into the `open` attribute. The summary becomes a plain heading. */
    .toc-details::details-content {
      content-visibility: visible;
    }
    .toc-details summary {
      min-height: 0;
      cursor: default;
      pointer-events: none;
    }
    .toc-details summary :global(.icon) {
      display: none;
    }
    .toc-details summary::before {
      display: none;
    }
    .toc {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: var(--vt-space-lg);
    }
    .toc li {
      margin-bottom: var(--vt-space-sm);
    }
  }
  .back a {
    display: inline-flex;
    align-items: center;
    min-height: var(--vt-touch-min);
  }

  /* Reading column: <= 75 characters per line. Cyrillic glyphs are narrower than the "0" that `ch` measures, so 56ch ~ 72 Cyrillic characters. */
  .prose {
    max-width: 56ch;
    color: var(--vt-color-text);
  }
  .prose :global(h2) {
    margin-top: var(--vt-space-lg);
    margin-bottom: var(--vt-space-sm);
    font-family: var(--vt-font-display);
    font-size: var(--vt-fs-heading);
    font-weight: var(--vt-fw-heading);
    line-height: var(--vt-lh-heading);
    scroll-margin-top: var(--vt-space-lg);
  }
  .prose :global(h2:first-child) {
    margin-top: 0;
  }
  @media (min-width: 400px) {
    .prose :global(h2) {
      margin-top: var(--vt-space-xl);
    }
    .prose :global(h2:first-child) {
      margin-top: 0;
    }
  }
  .prose :global(h3) {
    margin-top: var(--vt-space-lg);
    margin-bottom: var(--vt-space-xs);
    font-family: var(--vt-font-display);
    font-size: var(--vt-fs-card-title);
    font-weight: var(--vt-fw-card-title);
    line-height: var(--vt-lh-card-title);
  }
  .prose :global(p),
  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--vt-space-md);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-inline-start: var(--vt-space-lg);
  }
  .prose :global(li) {
    margin-bottom: var(--vt-space-sm);
  }
  .prose :global(strong) {
    font-weight: var(--vt-fw-heading);
  }
  .prose :global(a) {
    color: var(--vt-color-accent-deep);
    text-underline-offset: var(--vt-space-xs);
  }

  /* Print: drop chrome and shadows, keep the text and show link targets. */
  @media print {
    :global(.site-header),
    :global(.site-footer),
    :global(.skip-link),
    :global(.toc-card),
    :global(.back) {
      display: none;
    }
    :global(article.neu-card.body-card) {
      box-shadow: none;
      padding: 0;
    }
    .prose {
      max-width: none;
    }
    .prose :global(a[href^="http"])::after {
      content: " (" attr(href) ")";
    }
    .prose :global(h2) {
      break-after: avoid;
    }
    .prose :global(li),
    .prose :global(p) {
      break-inside: avoid;
    }
  }
</style>

<script>
  // From 600 px the contents list is permanent: keep `open` in sync (CSS already shows it, so nothing moves) and make the
  // summary inert there. Below 600 px it is a normal closed-by-default disclosure.
  const details = document.querySelector<HTMLDetailsElement>(".toc-details");
  if (details) {
    const wide = matchMedia("(min-width: 600px)");
    const summary = details.querySelector("summary")!;
    const sync = () => {
      details.open = wide.matches;
      if (wide.matches) summary.tabIndex = -1; // inert heading, not a control
      else summary.removeAttribute("tabindex");
    };
    sync();
    wide.addEventListener("change", sync);
    summary.addEventListener("click", (e) => {
      if (wide.matches) e.preventDefault();
    });
  }
</script>
