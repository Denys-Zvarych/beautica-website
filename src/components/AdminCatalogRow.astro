---
// One editable catalog row (W041): a category or a service type, as ONE plain <form method="post"> to /admin/catalog (no script: ADMIN_CSP has none).
// Save is the FIRST submit button, so Enter in a field saves. «Видалити» is a <details> confirm: nothing is sent until the second submit.
// W049 (category icon) adds its field next to the name; keep the markup in the `.fields` grid.
import CtaButton from "./CtaButton.astro";
import { t } from "../i18n/t";
interface Props {
  kind: "category" | "type";
  /** Category wire name, or the type's id. */
  id: string;
  /** A type's category (wire name): keeps its <details> open after the redirect. */
  cat?: string;
  page: number;
  name: string;
  /** Type rows only: the English name (omit for a category = no field). */
  nameEn?: string;
  active: boolean;
  /** false = no hide / show / delete (a category that is not APPROVED). */
  actionable?: boolean;
  /** false = «Видалити» is a disabled button; the backend still enforces it (409 CATALOG_IN_USE). */
  deletable: boolean;
  invalid?: boolean;
}
const { kind, id, cat, page, name, nameEn, active, actionable = true, deletable, invalid = false } = Astro.props;
const k = `${kind}-${id}`;
---

<form method="post" action="/admin/catalog" class="row">
  <input type="hidden" name="kind" value={kind} />
  <input type="hidden" name="id" value={id} />
  {cat && <input type="hidden" name="cat" value={cat} />}
  {page > 1 && <input type="hidden" name="p" value={page} />}
  <input type="hidden" name="origName" value={name} />
  {nameEn !== undefined && <input type="hidden" name="origNameEn" value={nameEn} />}
  <div class="fields">
    <div class="f">
      <label class="vt-label" for={`n-${k}`}>{t("admin.catalog.name")}</label>
      <input class="adm-field" id={`n-${k}`} name="name" type="text" required maxlength="400" value={name} autocomplete="off" aria-invalid={invalid ? "true" : undefined} />
    </div>
    {nameEn !== undefined && (
      <div class="f">
        <label class="vt-label" for={`e-${k}`}>{t("admin.catalog.nameEn")}</label>
        <input class="adm-field" id={`e-${k}`} name="nameEn" type="text" maxlength="400" value={nameEn} autocomplete="off" lang="en" />
      </div>
    )}
  </div>
  <div class="actions">
    <CtaButton type="submit" name="action" value="save">{t("admin.catalog.save")}</CtaButton>
    {actionable && <CtaButton type="submit" name="action" value={active ? "hide" : "show"}>{active ? t("admin.catalog.hide") : t("admin.catalog.show")}</CtaButton>}
  </div>
  {actionable && (deletable ? (
    <details class="del">
      <summary class="vt-label"><span class="vt-u">{t("admin.catalog.deleteOpen")}</span></summary>
      <p class="vt-label">{t("admin.catalog.deleteWarn")}</p>
      <input type="hidden" name="confirm" value="1" />
      <CtaButton type="submit" name="action" value="delete">{t("admin.catalog.deleteConfirm")}</CtaButton>
    </details>
  ) : (
    <div class="blocked">
      <CtaButton type="button" disabled>{t("admin.catalog.deleteOpen")}</CtaButton>
      <p class="vt-label">{t("admin.catalog.deleteBlocked")}</p>
    </div>
  ))}
</form>

<style>
  .row {
    display: grid;
    gap: var(--vt-space-sm);
  }
  .fields {
    display: grid;
    gap: var(--vt-space-sm);
  }
  .f {
    display: grid;
    gap: var(--vt-space-xs);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--vt-space-md);
    margin-top: var(--vt-space-sm);
  }
  .del,
  .blocked {
    margin-top: var(--vt-space-sm);
  }
  .blocked {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--vt-space-md);
  }
  .blocked p {
    margin: 0;
  }
  .del[open] {
    display: grid;
    gap: var(--vt-space-sm);
  }
  .del summary {
    display: flex;
    align-items: center;
    min-height: var(--vt-touch-min);
    cursor: pointer;
  }
  .del[open] summary {
    margin-bottom: var(--vt-space-xs);
  }
  .del :global(.cta) {
    justify-self: start;
  }
  @media (min-width: 600px) {
    .fields {
      grid-template-columns: repeat(auto-fit, minmax(0, 1fr));
    }
  }
</style>
