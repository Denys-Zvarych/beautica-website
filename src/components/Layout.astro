---
import "../styles/fonts.css";
import "../styles/tokens.css";
import "../styles/base.css";
import nunitoCyr from "@fontsource-variable/nunito/files/nunito-cyrillic-wght-normal.woff2?url";
import nunitoLat from "@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url";
import comfortaaCyr from "@fontsource-variable/comfortaa/files/comfortaa-cyrillic-wght-normal.woff2?url";
import comfortaaLat from "@fontsource-variable/comfortaa/files/comfortaa-latin-wght-normal.woff2?url";
import nunitoBasic from "../fonts/nunito-latin-basic-wght-normal.woff2?url";
import comfortaaBasic from "../fonts/comfortaa-latin-basic-wght-normal.woff2?url";
import Seo from "./Seo.astro";
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import { t, defaultLocale } from "../i18n/t";
import Analytics from "./Analytics.astro";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  robots?: string;
  canonicalPath?: string;
  image?: string;
  imageAlt?: string;
  ogType?: string;
  /** summary_large_image for static pages (default), summary for profiles. */
  twitterCard?: "summary_large_image" | "summary";
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Hide the header (a hero page that already shows the logo). Default false. */
  hideHeader?: boolean;
  /** Hide the footer (the booking-link pages are one app-like column with its own bottom bar). Default false. */
  hideFooter?: boolean;
  /** Preload the two Latin font files too (default true). The link pages skip them: their Latin glyphs are digits and punctuation, which their small Latin core (book.css) covers, so the big files are never requested there. */
  preloadLatin?: boolean;
  /** Legal pages: preload the small "latin basic" files (fonts-legal.css, ~44 KB for both) instead of the full Latin faces (~72 KB). The page must import fonts-legal.css after Layout. Default false. */
  basicLatin?: boolean;
  /** `<meta name="referrer" content="no-referrer">` so sub-resource requests never carry a token URL (token routes). Default false. */
  noReferrer?: boolean;
  /** An origin to open a connection to early (the booking API on the link pages). Default none. */
  preconnect?: string;
  /** Origin of a cross-origin hero image (cover/avatar on R2). Plain preconnect, no `crossorigin`: image fetches are no-cors and would not reuse a CORS connection. Emitted even when it equals `preconnect`: the API hint is a CORS connection and cannot serve no-cors image fetches. Default none. */
  preconnectImage?: string;
  /** Cloudflare Web Analytics + Umami (phase 007). Token routes pass `false` and get neither tag; `noReferrer` pages never get them either. Default true. */
  analytics?: boolean;
}

const { hideHeader = false, hideFooter = false, noReferrer = false, preloadLatin = true, basicLatin = false, preconnect, preconnectImage, analytics = true, ...seo } = Astro.props;
const withAnalytics = analytics && !noReferrer; // a token route (noReferrer) must never carry analytics, even if a caller forgets the prop
---

<!doctype html>
<html lang={defaultLocale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {noReferrer && <meta name="referrer" content="no-referrer" />}
    {preconnect && <link rel="preconnect" href={preconnect} crossorigin />}
    {preconnectImage && <link rel="preconnect" href={preconnectImage} />}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" as="font" type="font/woff2" href={nunitoCyr} crossorigin />
    {preloadLatin && <link rel="preload" as="font" type="font/woff2" href={basicLatin ? nunitoBasic : nunitoLat} crossorigin />}
    <!-- Latin too: « » digits and brand names inside Ukrainian prose use it, and a late arrival reflowed lines (CLS). -->
    <link rel="preload" as="font" type="font/woff2" href={comfortaaCyr} crossorigin />
    <!-- Comfortaa Latin: the "Beautica" wordmark/headings render with it on every route, so it arrives with the first paint
         (a lazy fetch swapped the face after layout; token pages also need it preloaded so no fetch carries the page URL as Referer). -->
    {preloadLatin && <link rel="preload" as="font" type="font/woff2" href={basicLatin ? comfortaaBasic : comfortaaLat} crossorigin />}
    <Seo {...seo} />
    {withAnalytics && <Analytics />}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t("a11y.skipToContent")}</a>
    {!hideHeader && <Header />}
    <slot />
    {!hideFooter && <Footer />}
  </body>
</html>
