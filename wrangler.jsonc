{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beautica-site",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": true,
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  }
}
