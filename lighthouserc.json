{
  "ci": {
    "collect": {
      "staticDistDir": "./dist/client",
      "url": [
        "http://localhost/index.html",
        "http://localhost/privacy.html",
        "http://localhost/terms.html",
        "http://localhost/support.html",
        "http://localhost/delete-account.html",
        "http://localhost/404.html",
        "http://localhost/l/invite.html",
        "http://localhost/l/booking.html",
        "http://localhost/l/review.html",
        "http://localhost/l/cancel.html",
        "http://localhost/l/cancel-confirmed.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new",
        "blockedUrlPatterns": ["https://cloud.umami.is/*", "https://static.cloudflareinsights.com/*"]
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": "http://[^/]+/index\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.005 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "total-blocking-time": ["error", { "maxNumericValue": 50 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 5120 }],
            "resource-summary:font:count": ["error", { "maxNumericValue": 4 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 112640 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 614400 }]
          }
        },
        {
          "matchingUrlPattern": "http://[^/]+/(privacy|terms|support|delete-account)\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 1 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.005 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "total-blocking-time": ["error", { "maxNumericValue": 50 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 5120 }],
            "resource-summary:font:count": ["error", { "maxNumericValue": 4 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 112640 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 153600 }]
          }
        },
        {
          "matchingUrlPattern": "http://[^/]+/(404|l/(invite|booking|review))\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 0.66 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.005 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "total-blocking-time": ["error", { "maxNumericValue": 50 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 5120 }],
            "resource-summary:font:count": ["error", { "maxNumericValue": 4 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 112640 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 153600 }]
          }
        },
        {
          "_comment": "l/cancel only: read-only states, note, validation and the reminder picker grew its script (5460 B gz at 8516a42 > 5120); phase 026 multi-service tick list adds the item logic (6563 B transferred uncompressed by the lhci static server, 2.9 KB gz, 4 requests, measured on /l/cancel.html; format chunk already inlined with ?own); budget 7168 = 6563 + ~600 B headroom (2026-11-05, architect). The README rule is JS <= 5 KB gz; this byte cap is only a regression tripwire. The next raise needs a gzip measurement in this comment.",
          "matchingUrlPattern": "http://[^/]+/l/cancel\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 0.66 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.005 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "total-blocking-time": ["error", { "maxNumericValue": 50 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 7168 }],
            "resource-summary:font:count": ["error", { "maxNumericValue": 4 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 112640 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 153600 }]
          }
        },
        {
          "_comment": "l/cancel-confirmed only (phase 032): the cancel page (CancelPage, reminder-channel, http, recap-row, cancel-path, AppLinkPage) plus the calendar entry (CancelCalendar, calendar-links; ~3 KB gz). Measured 2026-11-08 on /l/cancel-confirmed.html: 11593 B transferred by the lhci static server (8 requests, identical in 3 runs); built JS 16384 B raw, 8140 B gz, OVER the README 5 KB gz rule (same reason as l/cancel: it is the full cancel page plus the required calendar block; code already shared, no duplicate to trim). Budget 12288 = 11593 + ~700 B headroom. This byte cap is only a regression tripwire; the next raise needs a gzip measurement in this comment. tests/ci-wiring.test.mjs compares the built script bytes with this cap.",
          "matchingUrlPattern": "http://[^/]+/l/cancel-confirmed\\.html$",
          "aggregationMethod": "median",
          "assertions": {
            "categories:performance": ["error", { "minScore": 0.95 }],
            "categories:accessibility": ["error", { "minScore": 1 }],
            "categories:seo": ["error", { "minScore": 0.66 }],
            "cumulative-layout-shift": ["error", { "maxNumericValue": 0.005 }],
            "largest-contentful-paint": ["error", { "maxNumericValue": 2000 }],
            "total-blocking-time": ["error", { "maxNumericValue": 50 }],
            "resource-summary:script:size": ["error", { "maxNumericValue": 12288 }],
            "resource-summary:font:count": ["error", { "maxNumericValue": 4 }],
            "resource-summary:font:size": ["error", { "maxNumericValue": 112640 }],
            "resource-summary:total:size": ["error", { "maxNumericValue": 153600 }]
          }
        }
      ]
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci" }
  }
}
