{
  "name": "beautica-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "list:not-live": "node scripts/list-not-live.mjs",
    "check:cls": "node scripts/measure-cls.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:static": "node --test --test-reporter=spec tests/static-build.test.mjs",
    "check:cls:ci": "node scripts/measure-cls.mjs --runs 1 --routes /,/privacy,/delete-account,/l/cancel",
    "check:lighthouse": "lhci autorun",
    "check:lighthouse-ssr": "node scripts/lighthouse-ssr.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/comfortaa": "5.3.0",
    "@fontsource-variable/nunito": "5.3.0",
    "astro": "7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@lhci/cli": "0.15.1",
    "html-validate": "11.16.4",
    "playwright-core": "1.64.1",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "wrangler": "4.151.2"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
